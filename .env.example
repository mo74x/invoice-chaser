PORT=3000
APP_URL=http://localhost:3000
NODE_ENV=development

# Database & Redis
DATABASE_URL="postgresql://postgres@localhost:5432/invoice_chaser?schema=public"
REDIS_HOST=localhost
REDIS_PORT=6379

# Encryption (32-byte / 64 hex characters for AES-256-GCM)
# Generate fresh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Stripe Credentials (set 'sk_test_mock' for deterministic offline mock mode)
STRIPE_SECRET_KEY=sk_test_mock
STRIPE_CLIENT_ID=ca_mock_12345678
STRIPE_WEBHOOK_SECRET=whsec_test_secret

# Resend Mail Credentials (set 're_mock' for offline mock mode)
RESEND_API_KEY=re_mock
RESEND_FROM_DOMAIN=onboarding@resend.dev
RESEND_WEBHOOK_SECRET=whsec_test_resend_secret

# Anthropic Claude API Key (set 'sk-ant-mock' for heuristic offline mock mode)
ANTHROPIC_API_KEY=sk-ant-mock
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Optional Alert Webhook
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...

